<mxfile host="app.diagrams.net" agent="krebb-hardware-docs" version="24.0.0"><diagram id="page-wiring" name="Wiring"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title1" value="&lt;b&gt;Krebb One: wiring (page 1 of 2)&lt;/b&gt;&lt;br&gt;Research prototype, not a medical device. DS18B20 = skin-contact temperature trend. DHT11 = ambient context (humidity is not sent over BLE)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1000" height="44" as="geometry"/></mxCell><mxCell id="esp" value="&lt;b&gt;U1: ESP32-S3-DevKitC-1&lt;/b&gt;&lt;br&gt;(ESP32-S3-WROOM-1; antenna end up, USB ports at the bottom)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="300" height="640" as="geometry"/></mxCell><mxCell id="esp_3v3" value="J1 pin 1: 3V3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#D32F2F;fontColor=#D32F2F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="127" width="130" height="26" as="geometry"/></mxCell><mxCell id="esp_g4" value="J1 pin 4: GPIO4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#1E6FD9;fontColor=#1E6FD9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="197" width="130" height="26" as="geometry"/></mxCell><mxCell id="esp_g5" value="J1 pin 5: GPIO5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#F57C00;fontColor=#F57C00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="267" width="130" height="26" as="geometry"/></mxCell><mxCell id="esp_gnd" value="J3 pin 1: G (GND)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="127" width="130" height="26" as="geometry"/></mxCell><mxCell id="esp_note" value="&lt;b&gt;Used pins only:&lt;/b&gt; J1-1 3V3, J1-4 GPIO4, J1-5 GPIO5, J3-1 G.&lt;br&gt;&lt;br&gt;&lt;b&gt;AVOID (do not wire):&lt;/b&gt;&lt;br&gt;GPIO0, 3, 45, 46: strapping&lt;br&gt;GPIO19, 20: USB D-/D+&lt;br&gt;GPIO43, 44: UART0 (UART port)&lt;br&gt;GPIO38, 48: onboard RGB LED (v1.1 / v1.0)&lt;br&gt;GPIO26-37: flash / PSRAM (35-37 on headers)&lt;br&gt;GPIO39-42, 47: JTAG / differential clock&lt;br&gt;&lt;br&gt;Power from the laptop or a battery power bank via the &lt;b&gt;UART&lt;/b&gt; USB-C port (default). Never 5V for the sensors." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="280" height="340" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;U2: DS18B20&lt;/b&gt; (powered mode)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1E6FD9;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="260" as="geometry"/></mxCell><mxCell id="ds_note" value="TO-92 (datasheet pins): 1 GND, 2 DQ, 3 VDD. Flat face toward you, leads down: left GND, middle DQ, right VDD (verify on bench).&lt;br&gt;Probe wires (typical, verify): red VDD, black GND, yellow/white DQ.&lt;br&gt;&lt;b&gt;Reversed VDD/GND can destroy it. Check before power.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="200" height="200" as="geometry"/></mxCell><mxCell id="ds_vdd" value="VDD (3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#D32F2F;fontColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="236" y="127" width="84" height="26" as="geometry"/></mxCell><mxCell id="ds_dq" value="DQ (2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#1E6FD9;fontColor=#1E6FD9;" vertex="1" parent="1"><mxGeometry x="236" y="197" width="84" height="26" as="geometry"/></mxCell><mxCell id="ds_gnd" value="GND (1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="236" y="267" width="84" height="26" as="geometry"/></mxCell><mxCell id="dht" value="&lt;b&gt;U3: DHT11&lt;/b&gt; (ambient)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="300" height="310" as="geometry"/></mxCell><mxCell id="dht_note" value="Bare 4-pin (front/grille toward you, pins down): VCC, DATA, NC, GND. R2 10k &lt;b&gt;required&lt;/b&gt;.&lt;br&gt;3-pin module: VCC, DATA, GND (order varies, read silkscreen). Built-in pull-up: &lt;b&gt;omit R2&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="200" height="240" as="geometry"/></mxCell><mxCell id="dht_vcc" value="VCC (1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#D32F2F;fontColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="236" y="427" width="84" height="26" as="geometry"/></mxCell><mxCell id="dht_data" value="DATA (2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#F57C00;fontColor=#F57C00;" vertex="1" parent="1"><mxGeometry x="236" y="497" width="84" height="26" as="geometry"/></mxCell><mxCell id="dht_nc" value="NC (3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="1"><mxGeometry x="236" y="567" width="84" height="26" as="geometry"/></mxCell><mxCell id="dht_gnd" value="GND (4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="236" y="637" width="84" height="26" as="geometry"/></mxCell><mxCell id="r1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="385" y="158" width="30" height="34" as="geometry"/></mxCell><mxCell id="r1_lbl" value="&lt;b&gt;R1&lt;/b&gt;&lt;br&gt;4.7 k&amp;#937;&lt;br&gt;DQ pull-up" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="152" width="80" height="46" as="geometry"/></mxCell><mxCell id="r2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="385" y="458" width="30" height="34" as="geometry"/></mxCell><mxCell id="r2_lbl" value="&lt;b&gt;R2&lt;/b&gt;&lt;br&gt;10 k&amp;#937;&lt;br&gt;bare 4-pin only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="452" width="90" height="46" as="geometry"/></mxCell><mxCell id="jV1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="395" y="135" width="10" height="10" as="geometry"/></mxCell><mxCell id="jQ1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E6FD9;strokeColor=#1E6FD9;" vertex="1" parent="1"><mxGeometry x="395" y="205" width="10" height="10" as="geometry"/></mxCell><mxCell id="jV3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="515" y="135" width="10" height="10" as="geometry"/></mxCell><mxCell id="jV2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="395" y="435" width="10" height="10" as="geometry"/></mxCell><mxCell id="jD2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#F57C00;" vertex="1" parent="1"><mxGeometry x="395" y="505" width="10" height="10" as="geometry"/></mxCell><mxCell id="jG2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="345" y="645" width="10" height="10" as="geometry"/></mxCell><mxCell id="jGB" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="345" y="735" width="10" height="10" as="geometry"/></mxCell><mxCell id="w_3v3_esp" value="3V3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp_3v3" target="jV3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_3v3_a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV3" target="jV1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_3v3_ds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV1" target="ds_vdd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_3v3_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV3" target="jV2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="440"/></Array></mxGeometry></mxCell><mxCell id="w_3v3_dht" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV2" target="dht_vcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_r1_top" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV1" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_r2_top" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#D32F2F;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jV2" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_dq_ds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#1E6FD9;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ds_dq" target="jQ1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_dq_r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#1E6FD9;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="jQ1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_dq_esp" value="SKIN_DQ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#1E6FD9;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jQ1" target="esp_g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_data_dht" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#F57C00;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dht_data" target="jD2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_data_r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#F57C00;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="jD2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_data_esp" value="AMB_DATA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#F57C00;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jD2" target="esp_g5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="510"/><mxPoint x="580" y="280"/></Array></mxGeometry></mxCell><mxCell id="w_gnd_ds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#000000;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ds_gnd" target="jG2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="280"/></Array></mxGeometry></mxCell><mxCell id="w_gnd_bus" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#000000;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jG2" target="jGB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_gnd_dht" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#000000;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dht_gnd" target="jG2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_gnd_esp" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#000000;strokeWidth=3;endArrow=none;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp_gnd" target="jGB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="140"/><mxPoint x="990" y="740"/></Array></mxGeometry></mxCell><mxCell id="lg_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_red" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="40" height="8" as="geometry"/></mxCell><mxCell id="lg_red_t" value="3V3 (J1 pin 1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="124" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg_blk" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="160" width="40" height="8" as="geometry"/></mxCell><mxCell id="lg_blk_t" value="GND (J3 pin 1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="154" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg_blu" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E6FD9;strokeColor=#1E6FD9;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="40" height="8" as="geometry"/></mxCell><mxCell id="lg_blu_t" value="SKIN_DQ = GPIO4 (DS18B20 DQ)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="184" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg_org" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#F57C00;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="40" height="8" as="geometry"/></mxCell><mxCell id="lg_org_t" value="AMB_DATA = GPIO5 (DHT11 DATA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="214" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg_hdr" value="&lt;b&gt;Header pins per Espressif ESP32-S3-DevKitC-1 v1.1 guide.&lt;/b&gt;&lt;br&gt;J1 is the left header, J3 the right, antenna end up (verify on your silkscreen)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="330" height="60" as="geometry"/></mxCell><mxCell id="lg_scope" value="No thermal camera, TMP117, BME280, MAX30102, SpO2, VOC or respiratory sensor in this build. Apple Watch and iPhone are not wired to anything." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="340" width="330" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-system" name="System block diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;Krebb One: system block diagram (page 2 of 2)&lt;/b&gt;&lt;br&gt;Research prototype, not a medical device or calorie tracker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="36" as="geometry"/></mxCell><mxCell id="s_ds" value="&lt;b&gt;DS18B20&lt;/b&gt;&lt;br&gt;skin-contact temperature&lt;br&gt;(GPIO4, 4.7k pull-up)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;fillColor=#E8F0FE;strokeColor=#1E6FD9;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="s_dht" value="&lt;b&gt;DHT11&lt;/b&gt;&lt;br&gt;ambient temperature&lt;br&gt;(GPIO5; humidity read, not sent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;fillColor=#FFF3E0;strokeColor=#F57C00;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="210" height="80" as="geometry"/></mxCell><mxCell id="s_esp" value="&lt;b&gt;ESP32-S3-DevKitC-1&lt;/b&gt;&lt;br&gt;BLE peripheral&lt;br&gt;reads sensors, notifies 1 Hz JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="240" height="110" as="geometry"/></mxCell><mxCell id="s_ios" value="&lt;b&gt;iPhone&lt;/b&gt;&lt;br&gt;Krebb app (BLE client)&lt;br&gt;session flow, display, mock mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="240" height="110" as="geometry"/></mxCell><mxCell id="s_watch" value="&lt;b&gt;Apple Watch&lt;/b&gt; (optional)&lt;br&gt;heart rate, steps, activity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="380" width="240" height="70" as="geometry"/></mxCell><mxCell id="s_mac" value="&lt;b&gt;MacBook&lt;/b&gt; (development)&lt;br&gt;firmware build, flashing, serial monitor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="240" height="70" as="geometry"/></mxCell><mxCell id="s_e1" value="1-Wire, powered from 3V3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#1E6FD9;strokeWidth=2;endArrow=block;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_ds" target="s_esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s_e2" value="single-wire, powered from 3V3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#F57C00;strokeWidth=2;endArrow=block;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_dht" target="s_esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s_e3" value="BLE notify, 1 Hz UTF-8 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_esp" target="s_ios"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s_e4" value="HealthKit context via iPhone (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_watch" target="s_ios"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s_e5" value="USB-C cable (UART port): power, flash, serial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#555555;strokeWidth=2;endArrow=classic;startArrow=none;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=classic;" edge="1" parent="1" source="s_mac" target="s_esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s_note" value="&lt;b&gt;BLE packet&lt;/b&gt; (docs/sensor-protocol.md):&lt;br&gt;timestampMs, skinTemperatureC, ambientTemperatureC, sensorQuality&lt;br&gt;Service F000A001-0451-4000-B000-000000000000&lt;br&gt;Measurement characteristic F000A002-0451-4000-B000-000000000000&lt;br&gt;Humidity, heart rate and activity are not sent by the ESP32.&lt;br&gt;&lt;br&gt;Only the within-session trend from baseline is meaningful for skin temperature; the ambient value is context for spotting confounders (HVAC changes, handling, contact loss, sensor exposure)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="700" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
